# =============================================================================
# Romance-Baiting Content Filter Experiments - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API Key (Required for: OpenAI Moderation API, Judge LLM)
# -----------------------------------------------------------------------------
# Get your key at: https://platform.openai.com/api-keys
# Format: sk-...
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Google Perspective API Key (Required for: Google Perspective evaluation)
# -----------------------------------------------------------------------------
# Get your key at: https://developers.perspectiveapi.com
# Format: AIza...
GOOGLE_PERSPECTIVE_API_KEY=

# -----------------------------------------------------------------------------
# HuggingFace Token (Required for: LLaMA Guard 3 evaluation)
# -----------------------------------------------------------------------------
# Get your token at: https://huggingface.co/settings/tokens
# IMPORTANT: You must first accept the license at:
#   https://huggingface.co/meta-llama/Llama-Guard-3-8B
# Format: hf_...
HUGGINGFACE_TOKEN=
